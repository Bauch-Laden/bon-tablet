# Kopieren nach .env und ausfüllen
ZETTLE_CLIENT_ID=
ZETTLE_API_KEY=

# 1 = Testmodus ohne Zettle (erzeugt zufällige Testbons)
ZETTLE_MOCK=0

PORT=3000
POLL_MS=4000

# PIN für das Backoffice (Nummer setzen, Testbon, Bons leeren)
BACKOFFICE_PIN=111222

# Nummernbereich der Bestellnummern
NR_MIN=1
NR_MAX=99

# Käufe, die älter sind, werden beim Start ignoriert (Minuten)
MAX_ALTER_MIN=30

# Artikel, die nicht in die Küche gehören (Teil des Namens, kommagetrennt)
AUSBLENDEN=Cola,Wasser,Ayran,Pfand
